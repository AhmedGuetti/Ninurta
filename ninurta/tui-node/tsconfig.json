{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true
  },
  "include": ["index.jsx", "src/**/*.ts", "src/**/*.tsx", "components/**/*.jsx", "lib/**/*.js"]
}
